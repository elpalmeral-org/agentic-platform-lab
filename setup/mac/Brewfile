# Utilidades
brew "jq"
brew "yq"
brew "gettext"          # envsubst, para renderizar las plantillas *.tpl
brew "gh"               # GitHub CLI
cask "1password-cli"    # op: kubeconfig y credenciales en 1Password
brew "awscli"           # paso 04: usuario IAM para el reto DNS-01 en Route 53
brew "shellcheck"       # F2.4 · scripts de platform-gitops (gitops-ok)
brew "cosign"           # F2.4 · verificar firmas de imágenes

