# Variables del laboratorio.
# Copia este fichero a lab.env (ignorado por git), rellena los valores y cárgalo con:
#   set -a; source lab.env; set +a

# Dominio local del homelab y subdominio del lab (wildcard hacia k3s01)
LAB_DOMAIN=example.internal
LAB_SUBDOMAIN=apl

# VM de Kubernetes
K3S_HOST=k3s01
K3S_FQDN=${K3S_HOST}.${LAB_DOMAIN}
K3S_IP=192.0.2.10
K3S_VMID=110
K3S_SSH_USER=admin
# Versión fijada de k3s (se rellena en el paso 02)
K3S_VERSION=

# Host Proxmox y VM docker01
PVE_HOST=pve-host   # nombre SSH del host Proxmox
DOCKER01_VMID=102

# GitHub y Port
GH_ORG=my-github-org
PORT_REGION=eu
